# DOC-OC v2 Environment Variables Configuration

# Server Port (auto-assigned by Render, Koyeb, or defaults to 8000)
PORT=8000

# VLM Inference Backend (OpenAI-compatible endpoint)
# Local llama-server: http://localhost:8080/v1/chat/completions
# Remote Hugging Face Space: https://<your-hf-space>.hf.space/v1/chat/completions
# Cloud VLM Endpoint: https://api.groq.com/openai/v1/chat/completions or https://openrouter.ai/api/v1/chat/completions
VLM_API_URL=http://localhost:8080/v1/chat/completions

# Optional API key for remote providers (leave blank for local llama-server)
VLM_API_KEY=

# Extraction timeout in seconds
VLM_TIMEOUT=120.0
